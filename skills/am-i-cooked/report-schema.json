{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "am-i-cooked report",
  "description": "Output of `scan.mjs --json`.",
  "type": "object",
  "required": ["verdict", "scannedAt", "lockfiles", "packagesScanned", "summary", "upgrades", "findings"],
  "properties": {
    "verdict": { "enum": ["safe", "a bit cooked", "cooked", "unknown"] },
    "scannedAt": { "type": "string", "format": "date-time" },
    "lockfiles": { "type": "array", "items": { "type": "string" } },
    "packagesScanned": { "type": "integer", "minimum": 0 },
    "ignored": { "type": "integer", "minimum": 0, "description": "Findings hidden by --ignore or .cookedignore." },
    "summary": {
      "type": "object",
      "required": ["riskScore", "total", "knownExploited", "theoretical"],
      "properties": {
        "riskScore": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Worst finding (CVSS x exploit multiplier) plus 2 per extra finding, capped at +15." },
        "total": { "type": "integer" },
        "knownExploited": { "type": "integer", "description": "In CISA KEV, or EPSS threshold reached, or a public exploit exists." },
        "theoretical": { "type": "integer", "description": "No known exploitation. Not a reachability analysis." }
      }
    },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ecosystem", "package", "installed", "target", "safeTarget", "fixes", "unfixed", "residualAfterSafe", "worstCvss", "majorJump"],
        "properties": {
          "ecosystem": { "enum": ["npm", "PyPI", "Pub", "crates.io", "Go", "RubyGems", "Packagist"] },
          "package": { "type": "string" },
          "installed": { "type": "string" },
          "target": { "type": ["string", "null"], "description": "Lowest version that clears every fixable finding. Null if no fix is known." },
          "safeTarget": { "type": ["string", "null"], "description": "Highest fix inside the installed major version, or null if none." },
          "residualAfterSafe": { "type": "integer", "description": "Findings still open after upgrading only to safeTarget." },
          "fixes": { "type": "integer", "description": "Findings cleared by the target." },
          "unfixed": { "type": "integer", "description": "Findings with no known fix." },
          "worstCvss": { "type": "number" },
          "majorJump": { "type": "boolean" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "ecosystem", "package", "installed", "fixedIn", "cvss", "kev", "likelyExploited", "knownExploited", "advisory", "osvId", "osv", "lockfile", "source"],
        "properties": {
          "id": { "type": "string", "description": "CVE id when known, otherwise GHSA or OSV id." },
          "title": { "type": "string" },
          "ecosystem": { "enum": ["npm", "PyPI", "Pub", "crates.io", "Go", "RubyGems", "Packagist"] },
          "package": { "type": "string" },
          "installed": { "type": "string" },
          "fixedIn": { "type": ["string", "null"] },
          "cvss": { "type": ["number", "null"] },
          "kev": { "type": "boolean", "description": "Listed in the CISA Known Exploited Vulnerabilities catalog." },
          "likelyExploited": { "type": "boolean", "description": "EPSS threshold reached or a public exploit exists." },
          "knownExploited": { "type": "boolean", "description": "kev or likelyExploited." },
          "advisory": { "type": "string", "format": "uri" },
          "osvId": { "type": "string" },
          "osv": { "type": "string", "format": "uri" },
          "lockfile": { "type": "string" },
          "source": { "enum": ["cve.now", "osv.dev", "none"] }
        }
      }
    }
  }
}
